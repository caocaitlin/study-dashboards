function esc(v){return String(v==null?"":v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");}
function isoDate(s){return s?new Date(s+"T00:00:00Z"):null;}
function isoFromDate(d){return d.toISOString().slice(0,10);}
function businessDays(start,end){if(!start||!end||end<start)return null;const a=isoDate(start),b=isoDate(end);let n=0;for(let d=new Date(a);d<=b;d.setUTCDate(d.getUTCDate()+1)){const w=d.getUTCDay();if(w!==0&&w!==6)n++;}return n;}
function getSpan(list,key){const ranges=list.map(x=>x[key]).filter(r=>r&&r[0]&&r[1]&&r[1]>=r[0]);if(!ranges.length)return null;const start=ranges.map(r=>r[0]).sort()[0],end=ranges.map(r=>r[1]).sort().slice(-1)[0];return{start,end,days:businessDays(start,end)};}
function rangeText(s,e){return s&&e?s+" → "+e:"Dates unavailable";}
function durationText(v){return v==null?"—":v+" business days";}
function changeValue(cur,init){if(cur==null||init==null||init===0)return null;return((cur-init)/init)*100;}
function changeHtml(v){if(v==null)return "<div class=\"delta neutral\">Change unavailable</div>";const sign=v>0?"+":"";const cls=v>0?"delay":v<0?"ahead":"neutral";const label=v>0?"Delay":v<0?"Ahead":"No change";return"<div class=\"delta "+cls+"\">"+label+" · "+sign+v.toFixed(1)+"%</div>";}
function metric(label,span,sub,delta){return"<div class=\"metric\"><div class=\"label\">"+esc(label)+"</div><div class=\"value\">"+(span?span.days+" <small style=\"font-size:13px;font-weight:550;color:#64748b\">BD</small>":"—")+"</div><div class=\"detail\">"+esc(span?rangeText(span.start,span.end):sub||"Timeline dates unavailable")+"</div>"+(delta?changeHtml(delta):"")+"</div>";}
function taskRange(t,key){return t[key]&&t[key].length===2?t[key]:null;}
function renderMetrics(){const cur=getSpan(tasks,"current"),ini=getSpan(tasks,"initial"),delta=changeValue(cur&&cur.days,ini&&ini.days);$("projectMetrics").innerHTML=metric("Current duration",cur,"No current timeline dates")+metric("Initial duration",ini,"No initial timeline dates")+"<div class=\"metric\"><div class=\"label\">Change</div><div class=\"value\">"+(delta==null?"—":(delta>0?"+":"")+delta.toFixed(1)+"%")+"</div><div class=\"detail\">Current span compared with initial span</div>"+changeHtml(delta)+"</div>";}
function renderMilestone(){const a=tasks.find(t=>t.name==="Initial Protocol Draft"),b=tasks.find(t=>t.name==="Database Go-Live");if(!a||!b){$("milestoneContent").innerHTML="<div class=\"notice\">Milestone unavailable: "+(!a?"Initial Protocol Draft":"Database Go-Live")+" could not be found on the board.</div>";return;}const current=a.current&&b.current?{start:a.current[0],end:b.current[1],days:businessDays(a.current[0],b.current[1])}:null;const initial=a.initial&&b.initial?{start:a.initial[0],end:b.initial[1],days:businessDays(a.initial[0],b.initial[1])}:null;const delta=changeValue(current&&current.days,initial&&initial.days);if(!current||!initial){$("milestoneContent").innerHTML="<div class=\"notice\">Milestone tasks were found, but one or more current or initial timeline dates are unavailable.</div>";return;}$("milestoneContent").innerHTML="<div class=\"milestone-grid\"><div><div class=\"mile-name\">"+esc(a.name)+" to "+esc(b.name)+"</div><div class=\"mile-range\">Current: "+esc(rangeText(current.start,current.end))+" · Initial: "+esc(rangeText(initial.start,initial.end))+"</div></div><div class=\"mile-stats\"><div class=\"mini-stat\"><b>"+current.days+" BD</b><span>Current</span></div><div class=\"mini-stat\"><b>"+initial.days+" BD</b><span>Initial</span></div><div class=\"mini-stat\"><b>"+(delta==null?"—":(delta>0?"+":"")+delta.toFixed(1)+"%")+"</b><span>Change</span>"+changeHtml(delta)+"</div></div></div>";}
function renderSpan(){const cur=getSpan(tasks,"current"),ini=getSpan(tasks,"initial"),a=tasks.find(t=>t.name==="Initial Protocol Draft"),b=tasks.find(t=>t.name==="Database Go-Live"),mile=a&&b&&a.current&&b.current?{start:a.current[0],end:b.current[1]}:null;const list=[cur&&cur.start,cur&&cur.end,ini&&ini.start,ini&&ini.end,mile&&mile.start,mile&&mile.end,SNAPSHOT.asOf].filter(Boolean).sort();if(!list.length){$("spanGraphic").innerHTML="<div class=\"notice\">No timeline dates are available.</div>";return;}const lo=isoDate(list[0]).getTime(),hi=isoDate(list[list.length-1]).getTime(),span=Math.max(86400000,hi-lo);const pos=d=>((isoDate(d).getTime()-lo)/span*100);const bar=(label,r,cls)=>r?"<div class=\"span-lane\"><span class=\"lane-label\">"+label+"</span><div class=\"lane-track\"><i class=\"span-bar "+cls+"\" style=\"left:"+pos(r.start)+"%;width:"+Math.max(.35,pos(r.end)-pos(r.start))+"%\" title=\""+esc(rangeText(r.start,r.end))+"\"></i></div></div>":"";const today=pos(SNAPSHOT.asOf);const laneLeft=window.matchMedia("(max-width:640px)").matches?88:108;const markerX=laneLeft+Math.max(0,$("spanGraphic").clientWidth-laneLeft)*today/100;$("spanGraphic").innerHTML="<div class=\"span-today\" style=\"left:left:"+markerX+"px\" aria-label=\"Today\"></div>"+bar("Initial",ini,"base")+bar("Current",cur,"current")+bar("Milestone",mile,"mile")+"<div class=\"span-ends\"><span>"+esc(list[0])+"</span><span>"+esc(list[list.length-1])+"</span></div>";}
function renderCards(){const cards=SNAPSHOT.groups.map(g=>{const rows=tasks.filter(t=>t.groupId===g.id);const c=getSpan(rows,"current"),i=getSpan(rows,"initial"),d=changeValue(c&&c.days,i&&i.days);return"<article class=\"group-card\" style=\"--gcolor:"+g.color+"\"><div class=\"group-title\" title=\""+esc(g.name)+"\">"+esc(g.name)+"</div><div class=\"group-primary\">"+(c?c.days+" BD":"—")+"</div><div class=\"group-dates\">"+esc(c?rangeText(c.start,c.end):"Current dates unavailable")+"</div><div class=\"group-secondary\"><span>Initial: "+(i?i.days+" BD":"—")+"</span><span>"+(d==null?"Change n/a":(d>0?"+":"")+d.toFixed(1)+"%")+"</span></div>"+changeHtml(d)+"</article>";}).join("");$("groupCards").innerHTML=cards;}
function periodStart(date,kind){const d=new Date(date);if(kind==="month")d.setUTCDate(1);else if(kind==="quarter"){d.setUTCDate(1);d.setUTCMonth(Math.floor(d.getUTCMonth()/3)*3);}else{d.setUTCMonth(0,1);}return d;}
function addPeriod(d,kind,n){const x=new Date(d);x.setUTCDate(1);x.setUTCMonth(x.getUTCMonth()+(kind==="month"?n:kind==="quarter"?3*n:12*n));return x;}
function periodIndex(a,b,kind){return kind==="month"?(b.getUTCFullYear()-a.getUTCFullYear())*12+b.getUTCMonth()-a.getUTCMonth():kind==="quarter"?(b.getUTCFullYear()-a.getUTCFullYear())*4+Math.floor(b.getUTCMonth()/3)-Math.floor(a.getUTCMonth()/3):b.getUTCFullYear()-a.getUTCFullYear();}
function periodLabel(d,kind){if(kind==="year")return String(d.getUTCFullYear());if(kind==="quarter")return"Q"+(Math.floor(d.getUTCMonth()/3)+1)+" "+d.getUTCFullYear();return new Intl.DateTimeFormat("en-US",{month:"short",year:"numeric",timeZone:"UTC"}).format(d);}
function timeX(iso,start,kind,unitWidth){if(!iso)return null;const d=isoDate(iso),base=periodStart(d,kind),idx=periodIndex(start,base,kind),next=addPeriod(base,kind,1),frac=(d.getTime()-base.getTime())/(next.getTime()-base.getTime());return(idx+frac)*unitWidth;}
function trackBars(range,start,kind,unitWidth,group){if(!range)return"";const x=timeX(range[0],start,kind,unitWidth),e=timeX(range[1],start,kind,unitWidth),w=Math.max(3,e-x+unitWidth/100);return"left:"+x+"px;width:"+w+"px";}
function renderTimeline(scrollLeft,scrollTop){const allDates=[SNAPSHOT.asOf];for(const t of tasks){for(const k of ["current","initial"]){if(t[k])allDates.push(t[k][0],t[k][1]);}}allDates.sort();const unit=scale==="month"?120:scale==="quarter"?180:240;const first=addPeriod(periodStart(isoDate(allDates[0]),scale),scale,-1);const last=addPeriod(periodStart(isoDate(allDates[allDates.length-1]),scale),scale,2);const count=Math.max(1,periodIndex(first,last,scale));const width=count*unit;const content=$("chartContent");content.style.setProperty("--track-width",width+"px");content.style.setProperty("--unit-width",unit+"px");const tickHtml=[];for(let i=0;i<count;i++){const d=addPeriod(first,scale,i);tickHtml.push("<div class=\"tick\" style=\"--unit-width:"+unit+"px\">"+esc(periodLabel(d,scale))+"</div>");}$("chartAxis").innerHTML="<div class=\"chart-row axis-row\"><div class=\"axis-label\">Group / task</div><div class=\"axis-track\">"+tickHtml.join("")+"</div></div>";const todayX=timeX(SNAPSHOT.asOf,first,scale,unit);let rowsHtml="";for(const g of SNAPSHOT.groups){const list=tasks.filter(t=>t.groupId===g.id);if(!list.length)continue;const current=getSpan(list,"current"),initial=getSpan(list,"initial"),open=!!expanded[g.id];let bars="";if(baseline&&initial)bars+="<div class=\"bar group-base\" style=\""+trackBars([initial.start,initial.end],first,scale,unit,true)+"\" aria-hidden=\"true\"></div>";if(current)bars+="<div class=\"bar group-current\" style=\""+trackBars([current.start,current.end],first,scale,unit,true)+"\" aria-label=\""+esc(g.name+" current group span "+rangeText(current.start,current.end))+"\"></div>";bars+="<div class=\"today-line\" style=\"left:"+todayX+"px\" aria-hidden=\"true\"></div>";rowsHtml+="<div class=\"chart-row group-row\" style=\"--gcolor:"+g.color+"\"><div class=\"name-cell\"><button type=\"button\" class=\"group-toggle\" data-toggle-group=\""+esc(g.id)+"\" aria-label=\""+(open?"Collapse ":"Expand ")+esc(g.name)+"\" aria-expanded=\""+open+"\">"+(open?"▾":"▸")+"</button><span class=\"group-name\">"+esc(g.name)+"</span><span class=\"group-count\">"+list.length+"</span></div><div class=\"track\">"+bars+"</div></div>";if(open){for(const t of list){let taskBars="";if(baseline&&t.initial)taskBars+="<button type=\"button\" class=\"bar base\" style=\""+trackBars(t.initial,first,scale,unit)+";--bar-color:"+t.statusColor+"\" data-task-id=\""+esc(t.id)+"\" aria-label=\"Open baseline details for "+esc(t.name)+"\"></button>";if(t.current)taskBars+="<button type=\"button\" class=\"bar current\" style=\""+trackBars(t.current,first,scale,unit)+";--bar-color:"+t.statusColor+"\" data-task-id=\""+esc(t.id)+"\" title=\""+esc(t.name+" · "+t.status+" · "+rangeText(t.current[0],t.current[1]))+"\" aria-label=\"Open details for "+esc(t.name)+"\"></button>";taskBars+="<div class=\"today-line\" style=\"left:"+todayX+"px\" aria-hidden=\"true\"></div>";rowsHtml+="<div class=\"chart-row task-row\"><div class=\"name-cell\"><button type=\"button\" class=\"task-name\" data-task-id=\""+esc(t.id)+"\">"+esc(t.name)+"</button></div><div class=\"track\">"+taskBars+"</div></div>";}}}$("chartRows").innerHTML=rowsHtml||"<div class=\"chart-empty\">No task rows are available.</div>";const view=$("chartViewport");requestAnimationFrame(()=>{if(scrollLeft!=null){view.scrollLeft=scrollLeft;view.scrollTop=scrollTop||0;}else{view.scrollLeft=Math.max(0,todayX-view.clientWidth*.45);view.scrollTop=0;}});}
function renderLegend(){$("statusLegend").innerHTML=SNAPSHOT.statusPalette.map(s=>"<span class=\"legend-item\"><i class=\"dot\" style=\"background:"+s.color+"\"></i>"+esc(s.label)+"</span>").join("");}
function renderAll(scrollLeft,scrollTop){$("subtitle").textContent="Clinical Research · "+tasks.length+" tasks across "+SNAPSHOT.groups.length+" groups · Durations in business days, Mon–Fri · As of "+SNAPSHOT.asOf;renderMetrics();renderMilestone();renderSpan();renderCards();renderLegend();renderTimeline(scrollLeft,scrollTop);}
function detail(t){$("dialogTitle").textContent=t.name;const cur=t.current,ini=t.initial;const rows=[["Group",t.group],["Current start",cur?cur[0]:"Unavailable"],["Current end",cur?cur[1]:"Unavailable"],["Initial start",ini?ini[0]:"Unavailable"],["Initial end",ini?ini[1]:"Unavailable"],["Calculated business days",cur?businessDays(cur[0],cur[1])+" BD":"Unavailable"],["Duration column",t.duration||"Unavailable"],["Status",t.status||"Unavailable"],["Stage",t.stage||"Unavailable"]];$("detailGrid").innerHTML=rows.map(r=>"<div class=\"detail\"><div class=\"detail-label\">"+esc(r[0])+"</div><div class=\"detail-value\">"+(r[0]==="Status"&&r[1]?"<span class=\"status-pill\"><i class=\"pill-dot\" style=\"background:"+t.statusColor+"\"></i>"+esc(r[1])+"</span>":esc(r[1]))+"</div></div>").join("");$("boardItemLink").href=t.url;$("taskDialog").showModal();$("closeDialog").focus();}
document.addEventListener("click",e=>{const taskBtn=e.target.closest("[data-task-id]");if(taskBtn){const t=tasks.find(x=>x.id===taskBtn.dataset.taskId);if(t)detail(t);return;}const toggle=e.target.closest("[data-toggle-group]");if(toggle){const id=toggle.dataset.toggleGroup;expanded[id]=!expanded[id];const v=$("chartViewport");renderTimeline(v.scrollLeft,v.scrollTop);$("liveAnnounce").textContent=(expanded[id]?"Expanded ":"Collapsed ")+((SNAPSHOT.groups.find(g=>g.id===id)||{}).name||"group");}});
$("closeDialog").addEventListener("click",()=>$("taskDialog").close());$("scaleSelect").addEventListener("change",e=>{scale=e.target.value;const v=$("chartViewport"),ratio=v.scrollLeft/Math.max(1,v.scrollWidth);renderTimeline(null,null);requestAnimationFrame(()=>{v.scrollLeft=ratio*v.scrollWidth;});});
function setBaseline(value){baseline=value;$("baselineOff").setAttribute("aria-pressed",String(!value));$("baselineOn").setAttribute("aria-pressed",String(value));const v=$("chartViewport");renderTimeline(v.scrollLeft,v.scrollTop);}
$("baselineOff").addEventListener("click",()=>setBaseline(false));$("baselineOn").addEventListener("click",()=>setBaseline(true));$("expandBtn").addEventListener("click",()=>{const allOpen=SNAPSHOT.groups.filter(g=>tasks.some(t=>t.groupId===g.id)).every(g=>expanded[g.id]);for(const g of SNAPSHOT.groups)expanded[g.id]=!allOpen;$("expandBtn").textContent=allOpen?"Expand all":"Collapse all";const v=$("chartViewport");renderTimeline(v.scrollLeft,v.scrollTop);$("liveAnnounce").textContent=allOpen?"All groups collapsed":"All groups expanded";});
async function refreshSnapshot(){const view=$("chartViewport"),left=view.scrollLeft,top=view.scrollTop;const button=$("refreshBtn"),load=$("loadline");button.disabled=true;button.textContent="↻ Refreshing";const latest=SNAPSHOT.items;let next=[];for(let i=0;i<latest.length;i+=25){next=next.concat(latest.slice(i,i+25));load.textContent="Loading "+next.length+" of "+latest.length+" tasks…";await new Promise(resolve=>requestAnimationFrame(()=>resolve()));}tasks=next;renderAll(left,top);load.textContent="Snapshot refreshed · "+tasks.length+" of "+tasks.length+" tasks loaded";$("liveAnnounce").textContent="Snapshot refresh complete. Current view retained.";button.disabled=false;button.textContent="↻ Refresh";}
$("refreshBtn").addEventListener("click",refreshSnapshot);$("taskDialog").addEventListener("click",e=>{if(e.target===$("taskDialog"))$("taskDialog").close();});
(async function init(){for(let i=0;i<SNAPSHOT.items.length;i+=25){tasks=SNAPSHOT.items.slice(0,i+25);$("loadline").textContent="Loading "+tasks.length+" of "+SNAPSHOT.items.length+" tasks…";await new Promise(resolve=>requestAnimationFrame(()=>resolve()));}tasks=SNAPSHOT.items;renderAll(null,null);$("loadline").textContent="Loaded "+tasks.length+" of "+tasks.length+" top-level tasks";firstLoad=false;})();
</script>
